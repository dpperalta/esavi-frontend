    "clsx": "^2.1.1",
    "i18next": "^26.4.0",
    "lucide-react": "^1.38.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
