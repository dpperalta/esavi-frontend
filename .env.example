VITE_API_BASE_URL=http://localhost:4500/api

# Fallback for the systemConfig row ESAVI_APP_COUNTRY_ISO_CODE (CASE-PROCESS.md §5.2).
# systemConfig wins, this is only read when the row is missing or empty — the same
# precedence the backend fixed in SPEC F43 §3.6. ISO 3166-1 alpha-3.
VITE_ESAVI_APP_COUNTRY_ISO_CODE=ECU

# Raster tile URL for <MapPointPicker> (CASE-PROCESS.md 5.5.5). Defaults to the
# OpenStreetMap tile server; a closed-network deployment points this at its own
# tile server without a code change. OSM attribution stays visible either way,
# it is a condition of use.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
